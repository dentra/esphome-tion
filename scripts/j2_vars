#!/bin/bash

version_tion=$(git rev-parse --abbrev-ref HEAD)
if [ "$1" != "" ]; then
  version_tion=$1
fi

# git ref of the release: tags are prefixed with "v"
version_tion_ref=v$version_tion
version_vport=2026.10.0
if [ "$version_tion" == "next" ]; then
  version_tion_ref=next
  version_vport="master"
fi

version_esphome=($(esphome version))
version_esphome=${version_esphome[1]}

vars=(
  ${vars[@]}
  version_tion=$version_tion
  version_tion_ref=$version_tion_ref
  version_esphome=$version_esphome
  version_vport=$version_vport
)

j2_vars=""
for v in "${vars[@]}" ; do
  j2_vars="$j2_vars -D $v"
done
